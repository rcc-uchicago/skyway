# --- reconcile helpers -------------------------------------------------------

_MINUTE_EPSILON = 0.01   # tolerance for whole-minute cost projection detection


def _is_projection(cost, unit_price):
    """Return True if cost looks like a whole-minute walltime projection."""
    if unit_price <= 0 or cost <= 0:
        return False
    implied_minutes = cost / unit_price * 60.0
    rounded = round(implied_minutes)
    return rounded >= 1 and abs(implied_minutes - rounded) <= _MINUTE_EPSILON


def _aws_stop_time(account, instance_id):
    """
    Return the actual stop time for a stopped AWS instance, or None.

    Checks the SkywayStopTime instance tag first (written by skyway_batch
    background jobs just before shutdown). Falls back to the timestamp embedded
    in StateTransitionReason for instances stopped via the AWS API; that field
    has no timestamp for OS-initiated shutdowns, so returns None in that case.
    """
    try:
        instances = list(account.ec2.instances.filter(InstanceIds=[instance_id]))
        if not instances:
            return None
        inst = instances[0]
        if inst.state['Name'] not in ('stopped', 'terminated'):
            return None
        for tag in (inst.tags or []):
            if tag['Key'] == 'SkywayStopTime':
                try:
                    return datetime.strptime(tag['Value'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
                except ValueError:
                    pass
        reason = inst.state_transition_reason or ''
        m = re.search(r'\((\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) GMT\)', reason)
        if m:
            return datetime.strptime(m.group(1), '%Y-%m-%d %H:%M:%S').replace(tzinfo=timezone.utc)
    except Exception as e:
        print(f"  WARNING: could not look up stop time for {instance_id}: {e}")
    return None


def _gcp_stop_time(account, instance_id):
    """
    Return the actual stop time for a stopped GCP instance via lastStopTimestamp,
    or None if the instance is still running or the field is absent.
    """
    try:
        for node in account.driver.list_nodes():
            if str(node.id) != str(instance_id):
                continue
            if node.state not in ('terminated', 'stopped'):
                return None
            self_link = node.extra.get('selfLink', '')
            if not self_link:
                return None
            path = self_link.split('/projects/' + str(node.driver.project), 1)[-1]
            obj = node.driver.connection.request(path).object or {}
            stop_ts = obj.get('lastStopTimestamp')
            if stop_ts:
                for fmt in ('%Y-%m-%dT%H:%M:%S.%f%z', '%Y-%m-%dT%H:%M:%S%z'):
                    try:
                        return datetime.strptime(stop_ts, fmt)
                    except ValueError:
                        continue
    except Exception as e:
        print(f"  WARNING: could not look up stop time for {instance_id}: {e}")
    return None


def _reconcile(account, vendor_name, user_name, apply_changes):
    """
    Find stale usage rows for user_name (cost is a launch-time walltime
    projection that was never updated), confirm each instance is stopped in the
    cloud, fetch the actual stop time, and rewrite End + Cost.

    Dry-run unless apply_changes=True; always creates a timestamped backup.
    Only AWS and GCP can supply actual stop times; other vendors are skipped.
    """
    if not os.path.isfile(account.usage_history):
        print("No usage history found.")
        return

    df = pd.read_pickle(account.usage_history)
    if df.empty:
        print("Usage history is empty.")
        return

    user_rows = df.index[df['User'] == user_name]
    if len(user_rows) == 0:
        print(f"No history found for '{user_name}'.")
        return

    stale_indices = []
    for idx in user_rows:
        row = df.loc[idx]
        price = account.get_unit_price_by_name(row['InstanceType'])
        if price is None or price <= 0:
            continue
        try:
            cost = float(row['Cost'])
        except (TypeError, ValueError):
            continue
        if _is_projection(cost, price):
            stale_indices.append(idx)

    if not stale_indices:
        print(f"No stale rows for '{user_name}' — nothing to reconcile.")
        return

    print(f"Found {len(stale_indices)} stale row(s) for '{user_name}'; "
          f"querying cloud for actual stop times...")

    repaired, skipped = [], []

    for idx in stale_indices:
        row = df.loc[idx]
        iid = str(row['InstanceID'])
        price = account.get_unit_price_by_name(row['InstanceType'])

        if vendor_name == 'aws':
            stop_time = _aws_stop_time(account, iid)
        elif vendor_name == 'gcp':
            stop_time = _gcp_stop_time(account, iid)
        else:
            skipped.append(iid)
            continue

        if stop_time is None:
            skipped.append(iid)
            continue

        start = pd.to_datetime(row['Start'], format='mixed', utc=True, errors='coerce')
        if pd.isna(start) or stop_time <= start:
            skipped.append(iid)
            continue

        elapsed_h = (stop_time - start).total_seconds() / 3600.0
        old_cost = float(row['Cost'])
        new_cost = elapsed_h * price
        repaired.append({
            'idx': idx,
            'iid': iid,
            'itype': row['InstanceType'],
            'start': start,
            'stop_time': stop_time,
            'elapsed_h': elapsed_h,
            'price': price,
            'old_cost': old_cost,
            'new_cost': new_cost,
            'delta': new_cost - old_cost,
        })

    if skipped:
        print(f"  {len(skipped)} instance(s) skipped: still running, stop time "
              f"unavailable, or vendor not supported (OCI/Azure).")
        if vendor_name == 'aws':
            print("  TIP: AWS instances stopped from inside the guest (e.g. via "
                  "sudo shutdown) do not carry a stop timestamp in the API unless "
                  "skyway_batch background mode recorded it as a SkywayStopTime tag. "
                  "Use skyway_history --close-at-walltime as a fallback.")

    if not repaired:
        print("Nothing to reconcile.")
        return

    print(tabulate(
        [[e['iid'][:20], e['itype'],
          e['start'].strftime('%Y-%m-%d %H:%M'),
          e['stop_time'].strftime('%Y-%m-%d %H:%M'),
          f"{e['elapsed_h']:.3f}", f"${e['price']}",
          f"${e['old_cost']:.4f}", f"${e['new_cost']:.4f}", f"${e['delta']:+.4f}"]
         for e in repaired],
        headers=['InstanceID', 'Type', 'Start (UTC)', 'Stop (UTC)',
                 'Actual_h', '$/h', 'OldCost', 'NewCost', 'Delta']))

    total_delta = sum(e['delta'] for e in repaired)
    print(f"\n{len(repaired)} row(s). Net cost change for '{user_name}': "
          f"${total_delta:+.4f}")

    if not apply_changes:
        print("\n[DRY RUN] No changes made. Re-run with --apply to write.")
        return

    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backup = f"{account.usage_history}.bak-{stamp}"
    shutil.copy2(account.usage_history, backup)
    print(f"Backup written: {backup}")

    fmt = '%Y-%m-%dT%H:%M:%S.%f%z'
    for e in repaired:
        df.loc[e['idx'], 'End'] = e['stop_time'].strftime(fmt)
        df.loc[e['idx'], 'Cost'] = e['new_cost']

    df.to_pickle(account.usage_history)
    print(f"Done. PKL updated: {account.usage_history}")


