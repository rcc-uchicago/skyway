class InstanceDescriptor:
    def __init__(self, jobname: str, account_name: str, node_type: str, walltime: str, vendor_name: str):
        self.jobname = jobname
        self.account_name = account_name
        self.node_type = node_type
        self.walltime = walltime
        self.vendor_name = vendor_name

        self.account = None
        if 'aws' in vendor_name:
            self.account = AWS(account_name)
        elif 'gcp' in vendor_name:
            self.account = GCP(account_name)
        elif 'azure' in vendor_name:
            self.account = AZURE(account_name)
        elif 'oci' in vendor_name:
            self.account = OCI(account_name)
        elif 'midway3' in vendor_name:
            self.account = SLURMCluster(account_name)

        self.user = os.environ['USER']

    def getUsage(self, user_name):
        # retrieve from database for the given account
        user_budget = self.account.get_budget(user_name=user_name, verbose=False)
        accumulating_cost, _ = self.account.get_cost_and_usage_from_db(user_name=user_name)
        running_cost = self.account.get_running_cost(verbose=False, user_name=user_name)
        remaining_balance = float(user_budget) - float(accumulating_cost) - float(running_cost)
        return user_budget, accumulating_cost, running_cost, remaining_balance

    def getUsageHistory(self, user_name):
        df = self.account.get_usage_history_from_db(user_name=user_name)
        return df

if __name__ == "__main__":

    colorama.init(autoreset=True)

    msg = "Skyway usage of a cloud account by users and by jobs"

    parser = argparse.ArgumentParser(description=msg)
    parser.add_argument('-u', '--user',  dest='username', default=None, help="User name (default: all users in the account)")
    parser.add_argument('-A', '--account', dest='account', default="", help="Account name")
    parser.add_argument('--byjob', dest='byjob', action='store_true', default=False, help="Show jobs if specified")
    parser.add_argument('--provider', dest='provider', default="", help="Vendor name: AWS, GCP, Azure, or RCC Midway")
    parser.add_argument('--reconcile', dest='reconcile', action='store_true', default=False,
                        help="Cross-check stale usage rows against the cloud and close any "
                             "that belong to stopped instances (dry-run by default; use --apply to write)")
    parser.add_argument('--apply', dest='apply_changes', action='store_true', default=False,
                        help="With --reconcile: write the repaired rows to the PKL "
                             "(creates a timestamped backup first)")

    args = parser.parse_args()

    user_name = args.username
    account_name = args.account
    provider = args.provider.lower()
    byjob = args.byjob
    reconcile = args.reconcile
    apply_changes = args.apply_changes

    if provider == "":
        # try to infer the vendor name from account
        if 'aws' in account_name:
            vendor_name = "aws"
        elif 'gcp' in account_name:
            vendor_name = "gcp"
        elif 'azure' in account_name:
            vendor_name = "azure"
        elif 'oci' in account_name:
            vendor_name = "oci"
        elif 'midway3' in account_name or 'rcc-staff' in account_name:
            vendor_name = "rcc-midway3"
    else:
        vendor_name = provider

    # get the env variable SKYWAYROOT
    skywayroot = os.environ['SKYWAYROOT']
    if skywayroot == "":
        raise Exception("SKYWAYROOT is not defined.")

    # create an instance descriptor (like with the dashboard)
    instanceDescriptor = InstanceDescriptor("", account_name, "", "", vendor_name)

    # determine which users to display
    if user_name is not None:
        users_to_show = [user_name]
    else:
        users_to_show = list(instanceDescriptor.account.users.keys())

    # reconcile stale usage rows against the cloud before displaying
    if reconcile:
        reconcile_user = user_name if user_name is not None else os.environ['USER']
        _reconcile(instanceDescriptor.account, vendor_name, reconcile_user, apply_changes)
        print("")

    # usage
    headers = ["User", 'Allocation', 'Usage', 'Running', 'Balance']
    data = []
    for uname in users_to_show:
        user_budget, usage, running_cost, balance = instanceDescriptor.getUsage(uname)
        data.append([uname, user_budget, f"${usage:.4f}", f"${running_cost:.4f}", f"${balance:.4f}"])
    print(tabulate(data, headers=headers))

    if byjob == True:
        for uname in users_to_show:
            df = instanceDescriptor.getUsageHistory(uname)

            if df.empty == True:
                headers = ['User','InstanceID','InstanceType','Start','End', 'Cost', 'Balance']
                print(tabulate([], headers=headers))
                print("")
            else:
                headers = ['User','InstanceID','InstanceType','Start','End', 'Cost', 'Balance']
                print(df)

    print("NOTE:")
    print("  + Running: live cost of currently active instances.")
    print("  + Usage and balance will be updated in the database after instances are terminated or stopped.")
    if byjob == True:
        print("  + An upward jump in Balance between two jobs indicates a budget adjustment.")
        print("    The jump size equals the amount added (new_budget - old_budget).")
    
