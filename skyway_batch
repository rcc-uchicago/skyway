class InstanceDescriptor:

    # in-guest fallback used when the instance cannot be stopped through the
    # cloud API: the walltime timer armed at launch is cancelled first, so that
    # the pending shutdown does not keep the node up on systems where a second
    # 'shutdown' does not replace the one already scheduled
    SHUTDOWN_FALLBACK_CMD = "sudo shutdown -c; sudo shutdown -P +1"

    def __init__(self, jobname: str, account_name: str, node_type: str, walltime: str, vendor_name: str):
        self.jobname = jobname
        self.account_name = account_name
        self.node_type = node_type
        self.walltime = walltime
        self.vendor_name = vendor_name

        self.account = None
        if 'aws' in vendor_name:
            self.account = AWS(account_name)
        elif 'gcp' in vendor_name:
            self.account = GCP(account_name)
        elif 'azure' in vendor_name:
            self.account = AZURE(account_name)
        elif 'oci' in vendor_name:
            self.account = OCI(account_name)
        elif 'midway3' in vendor_name:
            self.account = SLURMCluster(account_name)

        self.user = os.environ['USER']

    def requestNodes(self, retry=False, retry_interval=10, max_attempts=10):
        """
        Create the instance. With retry, a request that failed because every
        zone of the scan was out of capacity is repeated (with a new full scan)
        every retry_interval minutes, up to max_attempts scans in total. Any
        other failure (budget, quota, credentials, configuration) is returned
        at once, since waiting would not change the outcome.
        """
        attempt = 1
        while True:
            nodes = self.account.create_nodes(self.node_type, [self.jobname], need_confirmation=False, walltime=self.walltime)
            if nodes or not retry:
                return nodes
            if getattr(self.account, 'capacity_exhausted', False) is not True:
                return nodes

            if attempt >= max_attempts:
                print(Fore.RED + f"{self.node_type} is still out of capacity after "
                      f"{attempt} attempts; giving up.")
                return nodes

            print(Fore.YELLOW + f"{self.node_type} is out of capacity in every zone "
                  f"(attempt {attempt}/{max_attempts}); retrying in {retry_interval:g} minutes. "
                  f"Press Ctrl-C to cancel.")
            time.sleep(retry_interval * 60)
            attempt += 1

    def submitJob(self, script_name=None, pre_execute=[], auto_stop=True, background=True,
                  retry=False, retry_interval=10, max_attempts=10):
        # Background mode is not available for Slurm: there is no in-guest way
        # to cancel a Slurm allocation, so the node would stay up until walltime
        # if the script tries to shut itself down.
        if background and "midway3" in self.vendor_name:
            print(Fore.YELLOW + "Background mode is not supported for Slurm clusters; "
                  "using blocking mode.")
            background = False

        print(Fore.BLUE + f"Requesting node from {self.vendor_name} with account {self.account_name}")
        nodes = self.requestNodes(retry=retry, retry_interval=retry_interval, max_attempts=max_attempts)

        # create_nodes returns None when the budget check fails or the request
        # was declined, and {} when no instance came up: there is nothing to
        # run the script on, and nothing to release
        if not nodes:
            print(Fore.RED + "No instance was allocated: the job was not submitted.")
            return nodes

        background_ok = False
        try:
            # execute pre-execute commands after nodes are available: e.g. data transfers
            for cmd in pre_execute:
                cmd += " --account=" + self.account_name + " -J" + self.jobname
                os.system(cmd)

            if script_name is not None:
                if background:
                    rc = self.submitScriptBackground(script_name, auto_stop=auto_stop)
                    background_ok = (rc == 0)
                else:
                    # blocking: wait for the script to finish on the instance
                    status = self.runScript(script_name)
                    if status == 0:
                        print(Fore.GREEN + f"✓ Job {self.jobname} completed.")
                    else:
                        print(Fore.RED + f"Job {self.jobname} exited with status {status}.")
        finally:
            if background and background_ok:
                # The background script manages its own lifecycle. In --no-auto-stop
                # mode there is no shutdown command in the script, so remind the user.
                if not auto_stop:
                    print(f"{self.jobname} is left running until its walltime "
                          f"{self.walltime}; stop it with: "
                          f"skyway_stop --account={self.account_name} {self.jobname}")
            else:
                # Blocking mode completed, or background submission failed:
                # release the instance from the login node.
                if auto_stop:
                    self.releaseJob()
                else:
                    print(f"{self.jobname} is left running until its walltime "
                          f"{self.walltime}; stop it with: "
                          f"skyway_stop --account={self.account_name} {self.jobname}")

        return nodes

    def submitScriptBackground(self, script_name, auto_stop=True):
        """
        Copy the filtered job script to the instance and launch it in the
        background via nohup so SSH returns immediately.  The caller (login
        node) can then disconnect; the instance runs the script on its own.

        When auto_stop is True, a shutdown command is appended so the instance
        terminates itself as soon as the job finishes.  On AWS, the actual stop
        time is also recorded as a SkywayStopTime instance tag immediately
        before shutdown, so skyway_usage --reconcile can close the usage record
        at the real elapsed time rather than the projected walltime.

        Returns 0 on success, 1 on failure.
        """
        instanceID = self.account.get_instance_ID(self.jobname)
        if not instanceID:
            print(Fore.RED + f"Could not find a running instance named {self.jobname}.")
            return 1

        node_info = self.account.get_node_connection_info(instanceID)
        login = node_info['login']
        key = node_info['private_key']
        user_name, host = login.split('@', 1)

        # Filter the script: strip #SBATCH directives, comments, and skyway_ calls
        script_cmd = utils.script2cmd(script_name)

        tmp_path = None
        try:
            with tempfile.NamedTemporaryFile(mode='w', suffix='.sh', delete=False,
                                             prefix='skyway_batch_') as tmp:
                tmp.write('#!/bin/bash\n')
                tmp.write(script_cmd + '\n')
                if auto_stop:
                    if 'aws' in self.vendor_name:
                        # Record the actual stop time as an instance tag so that
                        # skyway_usage --reconcile can close the usage record
                        # accurately (AWS gives no API timestamp for OS-initiated
                        # shutdowns without this).
                        tmp.write(
                            'SKYWAY_IID=$(curl -s '
                            'http://169.254.169.254/latest/meta-data/instance-id '
                            '2>/dev/null)\n'
                            'SKYWAY_RGN=$(curl -s '
                            'http://169.254.169.254/latest/meta-data/placement/region '
                            '2>/dev/null)\n'
                            'aws ec2 create-tags --region "$SKYWAY_RGN" '
                            '--resources "$SKYWAY_IID" '
                            '--tags "Key=SkywayStopTime,'
                            'Value=$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
                            '2>/dev/null || true\n'
                        )
                    tmp.write('sudo shutdown -P now\n')
                tmp_path = tmp.name

            ssh_opts = ['-o', 'StrictHostKeyChecking=no',
                        '-o', 'UserKnownHostsFile=/dev/null']
            if key:
                ssh_opts = ['-i', key] + ssh_opts

            scp_cmd = (['scp'] + ssh_opts
                       + [tmp_path, f'{user_name}@{host}:/tmp/skyway_job.sh'])
            result = subprocess.run(scp_cmd, capture_output=True, text=True)
            if result.returncode != 0:
                print(Fore.RED + f"Could not copy script to {self.jobname}: "
                      f"{result.stderr.strip()}")
                return 1
        finally:
            if tmp_path and os.path.exists(tmp_path):
                os.unlink(tmp_path)

        remote_cmd = ('chmod +x /tmp/skyway_job.sh && '
                      '{ nohup /tmp/skyway_job.sh > /tmp/skyway_job.log 2>&1 '
                      '< /dev/null & }')
        result = utils.run_ssh(host, user_name, key, remote_cmd, run_timeout=30)
        if result is not None and result.returncode != 0:
            print(Fore.RED + f"Could not launch job on {self.jobname}: "
                  f"{result.stderr.strip()}")
            return 1

        print(Fore.GREEN + f"✓ Job {self.jobname} submitted; running in background "
              f"on the instance.")
        print(f"  Output: /tmp/skyway_job.log on the instance.")
        if auto_stop:
            print(f"  The instance will shut itself down when the job finishes.")
            print(f"  Afterward, ask an admin to run: "
                  f"skyway_usage --reconcile --apply -A {self.account_name} -u {self.user} "
                  f"to correct the usage record.")
        return 0

    def runScript(self, script_name):
        '''
        run the job script on the allocated node, and return its exit status
        '''
        if "midway3" in self.vendor_name:
            # for on-premises like midway3 instanceID is the host ip (which happens to be the node name)
            instanceID = self.account.get_host_ip(self.jobname)
        else:
            instanceID = self.account.get_instance_ID(self.jobname)

        if not instanceID:
            print(Fore.RED + f"Could not find a running instance named {self.jobname} to run {script_name} on.")
            return 1

        status = self.account.execute_script(instanceID, script_name)
        # backends that do not report an exit status yet
        return 0 if status is None else status

    def releaseJob(self):
        '''
        release the node now that the job script is done, so that the unused
        part of the walltime is not charged

        On the cloud backends the instance is stopped, not destroyed: the data
        on it is preserved and skyway_restart can bring it back. Stopping also
        closes the usage record at the real end time, so the user is billed for
        the time actually used instead of the full walltime projected at launch.
        '''
        print(Fore.BLUE + f"Releasing {self.jobname}: the rest of the walltime will not be charged.")
        try:
            self.account.release_node(self.jobname)
        except Exception as e:
            print(Fore.RED + f"Could not release {self.jobname} through the cloud API: {e}")
            self.armShutdown()

    def armShutdown(self):
        '''
        fall back to powering the instance off from inside the guest, so that a
        failure of the cloud API does not leave the node running until its
        walltime

        This is a safety net only: the vendor stops charging once the node is
        off, but nothing closes the usage record, which keeps holding the cost
        projected for the full walltime at launch until it is repaired.
        '''
        if "midway3" in self.vendor_name:
            print(Fore.RED + f"Cancel the job by hand: skyway_cancel --account={self.account_name} {self.jobname}")
            return

        instanceID = self.account.get_instance_ID(self.jobname)
        if not instanceID:
            print(f"{self.jobname} is no longer running; nothing to shut down.")
            return

        print(f"Falling back to shutting {self.jobname} down from inside the instance.")
        result = None
        try:
            node_info = self.account.get_node_connection_info(instanceID)
            user_name, host = node_info['login'].split('@', 1)
            result = utils.run_ssh(host, user_name, node_info['private_key'],
                                   self.SHUTDOWN_FALLBACK_CMD)
        except Exception as e:
            print(Fore.RED + f"Could not reach {self.jobname} over SSH: {e}")

        if result is None or result.returncode != 0:
            reason = result.stderr.strip() if result is not None else ""
            print(Fore.RED + f"Failed to shut {self.jobname} down from inside the instance. {reason}")
            print(Fore.RED + f"The instance is still running: stop it with "
                             f"skyway_stop --account={self.account_name} {self.jobname}")
            return

        print(f"✓ {self.jobname} will power itself off in a minute.")
        print(Fore.RED + f"NOTE: the usage record of {self.jobname} still holds the cost projected "
                         f"for the full walltime {self.walltime}, and needs to be repaired.")

'''
   parse the job script to get the account information, node type (constraint) and walltime
'''
def parse_script(filename):
    jobname = "my-run"
    account = ""
    constraint = ""
    walltime = ""
    skyway_cmds = []
    with open(filename, 'r') as f:
        lines = f.readlines()
        for line in lines:
            # extract only lines with #SBATCH, remove \n characters
            # remove all the spaces
            # split at '='
            if "#SBATCH" in line:
                # remove #SBATCH
                line = line.replace('#SBATCH ','').strip('\n')
                line = line.replace(' ','')
                args = line.split('=')
                if len(args) == 2:
                    if args[0] == "--job-name":
                        jobname = args[1]
                    if args[0] == "--account":
                        account = args[1]
                    if args[0] == "--constraint":
                        constraint = args[1]
                    if args[0] == "--time":
                        walltime = args[1]
            elif "skyway_" in line:
                skyway_cmds.append(line.strip('\n'))
            else:
                continue

    return { 'jobname': jobname,
             'account': account,
             'constraint': constraint,
             'walltime': walltime,
             'skyway_cmd': skyway_cmds
            }

if __name__ == "__main__":

    colorama.init(autoreset=True)

    msg = "Skyway CLI batch job submisssion"
    parser = argparse.ArgumentParser(description=msg)
    parser.add_argument('--no-auto-stop', dest='auto_stop', action='store_false',
                        help="Leave the instance running when the job script finishes, "
                             "until the walltime is reached (charged until then)")
    parser.add_argument('--wait', dest='background', action='store_false',
                        help="Block until the job finishes on the instance before "
                             "returning (the old default); by default skyway_batch "
                             "submits the script in background and returns immediately "
                             "so you can disconnect from the login node")
    parser.add_argument('--retry', action='store_true',
                        help="If the instance type is out of capacity in every zone, "
                             "keep retrying the full zone scan until an instance is "
                             "available (other failures are not retried)")
    parser.add_argument('--retry-interval', type=float, default=10, metavar='MINUTES',
                        help="Minutes to wait between retries (default: 10, minimum: 1)")
    parser.add_argument('--max-attempts', type=int, default=10, metavar='N',
                        help="With --retry, the maximum number of zone scans, "
                             "including the first one (default: 10)")
    parser.add_argument(dest='script', help="Job script to submit")
    cli_args = parser.parse_args()
    if cli_args.retry_interval < 1:
        parser.error("--retry-interval must be at least 1 minute")
    if cli_args.max_attempts < 1:
        parser.error("--max-attempts must be at least 1")

    script = cli_args.script
    auto_stop = cli_args.auto_stop
    background = cli_args.background
    args = parse_script(script)

    job_name = args['jobname']
    account_name = args['account']
    node_type = args['constraint']
    walltime = args['walltime']
    skyway_cmds = args['skyway_cmd']
    provider = ""

    if provider == "":
        # try to infer the vendor name from account
        if 'aws' in account_name:
            vendor_name = "aws"
        elif 'gcp' in account_name:
            vendor_name = "gcp"
        elif 'azure' in account_name:
            vendor_name = "azure"
        elif 'oci' in account_name:
            vendor_name = "oci"
        elif 'midway3' in account_name or 'rcc-staff' in account_name:
            vendor_name = "rcc-midway3"
        else:
            print(f"account name {account_name} is not valid")
            sys.exit(1)
    else:
        vendor_name = provider

    # get the env variable SKYWAYROOT
    skywayroot = os.environ['SKYWAYROOT']
    if skywayroot == "":
        raise Exception("SKYWAYROOT is not defined.")

    # create an instance descriptor
    instanceDescriptor = InstanceDescriptor(job_name, account_name, node_type, walltime, vendor_name)

    # submit job
    instanceDescriptor.submitJob(script_name=script, pre_execute=skyway_cmds,
                                 auto_stop=auto_stop, background=background,
                                 retry=cli_args.retry, retry_interval=cli_args.retry_interval,
                                 max_attempts=cli_args.max_attempts)
