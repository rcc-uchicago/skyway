#!/usr/bin/env python
import argparse
import os

import skyway
from skyway.cloud.aws import *
from skyway.cloud.gcp import *
from skyway.cloud.azure import *
from skyway.cloud.slurm import *
from skyway.cloud.oci import *

from tabulate import tabulate
import colorama
from colorama import Fore

def make_account(account_name, vendor_name):
    if 'aws' in vendor_name:
        return AWS(account_name)
    elif 'gcp' in vendor_name:
        return GCP(account_name)
    elif 'azure' in vendor_name:
        return AZURE(account_name)
    elif 'oci' in vendor_name:
        return OCI(account_name)
    elif 'midway3' in vendor_name or 'slurm' in vendor_name:
        return SLURMCluster(account_name)
    else:
        raise Exception(f"Cannot infer vendor from account name '{account_name}'. Use --provider.")

if __name__ == "__main__":

    colorama.init(autoreset=True)

    msg = "View or adjust the budget of a user in a cloud account"
    parser = argparse.ArgumentParser(description=msg)
    parser.add_argument('-A', '--account', dest='account', required=True, help="Account name")
    parser.add_argument('-u', '--user',    dest='username', default=None, help="User name")
    parser.add_argument('--provider',      dest='provider', default="",   help="Vendor name: aws, gcp, azure, oci")
    parser.add_argument('--set',           dest='set_budget', type=float, default=None, metavar='AMOUNT',
                        help="Set budget to AMOUNT")
    parser.add_argument('--add',           dest='add_budget', type=float, default=None, metavar='AMOUNT',
                        help="Increase budget by AMOUNT")
    parser.add_argument('--history',       dest='history', action='store_true', default=False,
                        help="Show budget adjustment history")
    parser.add_argument('--note',          dest='note', default="", help="Optional note for the adjustment")

    args = parser.parse_args()

    account_name = args.account
    user_name    = args.username
    provider     = args.provider.lower()

    skywayroot = os.environ.get('SKYWAYROOT', '')
    if skywayroot == '':
        raise Exception("SKYWAYROOT is not defined.")

    # infer vendor from account name if not given
    if provider == '':
        if 'aws' in account_name:
            vendor_name = 'aws'
        elif 'gcp' in account_name:
            vendor_name = 'gcp'
        elif 'azure' in account_name:
            vendor_name = 'azure'
        elif 'oci' in account_name:
            vendor_name = 'oci'
        elif 'midway3' in account_name or 'rcc-staff' in account_name:
            vendor_name = 'midway3'
        else:
            raise Exception("Cannot infer vendor from account name. Use --provider.")
    else:
        vendor_name = provider

    account = make_account(account_name, vendor_name)

    # --- show budget adjustment history ---
    if args.history:
        df = account.get_budget_history(user_name=user_name)
        if df.empty:
            print("No budget adjustments recorded.")
        else:
            print(tabulate(df, headers='keys', tablefmt='simple', showindex=False))
        raise SystemExit(0)

    # --- set or add budget ---
    if args.set_budget is not None or args.add_budget is not None:
        if user_name is None:
            parser.error("--user is required when adjusting a budget.")

        if args.set_budget is not None and args.add_budget is not None:
            parser.error("Use either --set or --add, not both.")

        current = float(account.users[user_name]['budget'])

        if args.set_budget is not None:
            new_budget = args.set_budget
        else:
            new_budget = current + args.add_budget

        print(f"Account : {account_name}")
        print(f"User    : {user_name}")
        print(f"Old budget: ${current:.2f}")
        print(f"New budget: ${new_budget:.2f}")
        response = input("Confirm? (y/n) ")
        if response.strip().lower() != 'y':
            print("Aborted.")
            raise SystemExit(0)

        account.update_budget(user_name, new_budget, note=args.note)
        print(Fore.GREEN + f"Budget updated: ${current:.2f} -> ${new_budget:.2f}")
        raise SystemExit(0)

    # --- default: show current budgets ---
    user_info = []
    if user_name is not None:
        users_to_show = [user_name]
    else:
        users_to_show = sorted(account.users.keys())

    for u in users_to_show:
        budget = account.users[u]['budget']
        user_info.append([u, f"${float(budget):.2f}"])

    print(f"\nAccount: {account_name}\n")
    print(tabulate(user_info, headers=['User', 'Budget']))
    print("")
